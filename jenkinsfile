pipeline {
    agent any
    environment {
        LABS = credentials("labcreds")
    }
    stages {
        stage('Build') {
            steps {
                sh 'pip3 install --user --break-system-packages pipenv'
                sh '$HOME/.local/bin/pipenv --rm || true'
                sh '$HOME/.local/bin/pipenv install'
                sh 'which python3'
                sh '$HOME/.local/bin/pipenv --venv'
                echo "Build completed successfully"
            }
        }

        stage('Test') {
            steps {
                sh '$HOME/.local/bin/pipenv run pytest'
                echo "Test completed successfully"
            }
        }

        stage('Package') {
            steps {
                sh 'zip -r retailproject.zip .'
                echo "Package completed successfully"
            }
        }

        stage('Deploy') {
            steps {
                sh 'sshpass -p $LABS_PSW scp -o StrictHostKeyChecking=no -r . $LABS_USR@g02.itversity.com:/home/itv015105/retailproject'
                echo "Deploy completed successfully"
            }
        }
    }
}
